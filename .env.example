# Copy to .env and fill in.

# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://basinwright:basinwright_dev@localhost:5433/basinwright?schema=public"

# --- Site -----------------------------------------------------------------
# Canonical origin, no trailing slash. Every og:image, canonical link, sitemap
# entry and llms.txt URL is absolute against this. Leave it unset in local
# development — the default is the production origin, which is deliberate: a
# wrong-but-absolute URL is far easier to spot than a missing one.
SITE_URL="https://basinwright.com"

# --- Auth -----------------------------------------------------------------
# Long random string. Generate with: openssl rand -base64 48
SESSION_SECRET=""

ADMIN_EMAIL="admin@basinwright.com"
ADMIN_PASSWORD=""
ADMIN_NAME="BasinWright Admin"

# --- AI (Together AI / any OpenAI-compatible endpoint) --------------------
AI_API_KEY=""
AI_BASE_URL="https://api.together.xyz/v1"
AI_MODEL="meta-llama/Llama-3.3-70B-Instruct-Turbo"

AI_MAX_TOKENS="800"
AI_TEMPERATURE="0.4"
