// BasinWright CMS — Postgres schema
// The homepage is fully content-managed: every block on the page is a `Section`,
// and every repeated card/logo/tier inside a block is an `Entry`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(EDITOR)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

/// The kind drives which React component renders the section.
///
/// The first block are the homepage's bespoke blocks; the second are the
/// general-purpose blocks that build out the editorial pages (About, Careers,
/// Trust Centre…) and can equally be dropped onto the homepage.
enum SectionKind {
  HERO
  LOGO_WALL
  PLATFORM_GRID
  WHY_PILLARS
  PLATFORM_TOPOLOGY
  COGNITIVE_SUBSTRATE
  AGENTS
  MODELS
  PRODUCTS
  INDUSTRIES
  SOLUTIONS
  INFRASTRUCTURE
  PRICING
  STATS
  CTA
  RICH_TEXT

  CALLOUT
  PROSE
  FEATURE_GRID
  STAT_BAND
  TIMELINE
  FLOW
  FAQ
  LINK_LIST
  DOC_LIST
  CONTACT
}

model Section {
  id            String      @id @default(cuid())
  /// Stable identifier used by the renderer, e.g. "hero", "products".
  key           String      @unique
  kind          SectionKind
  order         Int         @default(0)
  visible       Boolean     @default(true)

  /// Slug of the `Page` this block belongs to. The homepage is "home" and is
  /// not a `Page` row — it is the one page whose shell lives in code.
  page          String      @default("home")

  eyebrow       String?
  title         String?
  /// Hero renders each string as its own animated line.
  headlineLines String[]    @default([])
  subtitle      String?
  body          String?

  ctaLabel      String?
  ctaHref       String?
  ctaLabel2     String?
  ctaHref2      String?

  /// Free-form per-section options (background variant, columns, etc.).
  meta          Json?

  entries       Entry[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([page, order])
  @@map("sections")
}

/// The shell of an editorial page — everything above and around its blocks.
/// Its body is `Section` rows carrying the same `page` slug.
model Page {
  id             String   @id @default(cuid())
  /// URL slug, rendered at `/{slug}`. Reserved slugs (the library collections)
  /// are rejected by the admin action.
  slug           String   @unique
  title          String
  eyebrow        String?
  subtitle       String?
  published      Boolean  @default(true)
  order          Int      @default(0)

  seoTitle       String?
  seoDescription String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([order])
  @@map("pages")
}

model Entry {
  id        String   @id @default(cuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  order     Int      @default(0)
  visible   Boolean  @default(true)

  title     String
  subtitle  String?
  body      String?
  /// lucide-react icon name, e.g. "Cpu".
  icon      String?
  href      String?
  badge     String?
  /// Accent token: "brass" | "verdigris" | "slate" | "ember".
  accent    String?
  /// Feature lists, capability bullets, pricing line items.
  bullets   String[] @default([])
  meta      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, order])
  @@map("entries")
}

/// Which library collection a `Doc` belongs to. One enum value per index route
/// — see COLLECTIONS in src/lib/library.ts, which owns the slug and the copy.
enum DocKind {
  BLOG
  /// Worked designs, not customer stories — see prisma/content/reference-deployments.ts.
  /// Named CASE_STUDY once; renamed because the name itself was the claim.
  REFERENCE
  WHITEPAPER
  ARTICLE
  NEWS
  RESEARCH
  RELEASE_NOTE
}

/// A single piece of long-form content: a post, a case study, a whitepaper, a
/// learning article, a press item, a research note or a release entry. One
/// model rather than seven because they differ in framing, not in shape.
model Doc {
  id             String   @id @default(cuid())
  kind           DocKind
  /// Unique across the whole library, so a slug never resolves to two pieces.
  slug           String   @unique
  title          String
  subtitle       String?
  /// Card copy and meta description fallback.
  excerpt        String
  /// Markdown — the subset in src/lib/markdown.tsx.
  body           String

  /// Free-text grouping shown as a filter chip on the index, e.g. "Governance".
  category       String?
  /// Sector label for case studies and industry pieces, e.g. "Banking".
  industry       String?

  author         String?
  authorRole     String?
  readMinutes    Int      @default(6)

  featured       Boolean  @default(false)
  published      Boolean  @default(true)
  publishedAt    DateTime @default(now())

  /// Release notes only — the version the entry describes, e.g. "2026.7".
  version        String?
  tags           String[] @default([])
  /// Proof band on a case study: [{ label, value, caption }].
  metrics        Json?

  accent         String?
  icon           String?
  /// Behind the app subscription. The page shows a summary and sends the
  /// reader to app.basinwright.com rather than serving the full text.
  gated          Boolean  @default(false)

  seoTitle       String?
  seoDescription String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([kind, publishedAt])
  @@index([published, publishedAt])
  @@map("docs")
}

/// Site-wide strings (brand name, footer tagline, contact email, chat prompt…).
model SiteSetting {
  id    String  @id @default(cuid())
  key   String  @unique
  value String
  label String
  group String  @default("general")
  /// "text" | "textarea" | "url" | "email"
  type  String  @default("text")
  order Int     @default(0)

  @@index([group, order])
  @@map("site_settings")
}

model NavItem {
  id       String    @id @default(cuid())
  label    String
  href     String
  order    Int       @default(0)
  visible  Boolean   @default(true)
  /// Null for top-level items; set for dropdown children.
  parentId String?
  parent   NavItem?  @relation("NavChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children NavItem[] @relation("NavChildren")
  /// "header" | "footer" | "legal" (the thin row beneath the footer columns)
  location String    @default("header")
  /// Footer column heading this link sits under.
  group    String?

  @@index([location, order])
  @@map("nav_items")
}

// ---------------------------------------------------------------------------
// Captured data
// ---------------------------------------------------------------------------

model Lead {
  id         String   @id @default(cuid())
  name       String
  email      String
  company    String?
  role       String?
  interest   String?
  message    String?
  source     String   @default("website")
  handled    Boolean  @default(false)
  /// Industry id from the substrate console configurator, denormalised off
  /// `demoConfig` so the leads list can be scanned and filtered without
  /// unpacking JSON.
  industry   String?
  /// The whole `DemoConfig` the visitor built the console with — which systems
  /// they named, which decisions they picked, and what they said was hurting.
  /// The single most qualifying thing on the record.
  demoConfig Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([industry])
  @@map("leads")
}

model ChatConversation {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([createdAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// "user" | "assistant"
  role           String
  content        String
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}
